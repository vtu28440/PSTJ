public static void matrixRotation(List<List<Integer>> matrix,int r){
    int m=matrix.size();
    int n=matrix.get(0).size();
    int layers=Math.min(m,n)/2;

    for(int layer=0;layer<layers;layer++){
        List<Integer> a=new ArrayList<>();

        for(int i=layer;i<m-layer;i++)
            a.add(matrix.get(i).get(layer));

        for(int j=layer+1;j<n-layer;j++)
            a.add(matrix.get(m-layer-1).get(j));

        for(int i=m-layer-2;i>=layer;i--)
            a.add(matrix.get(i).get(n-layer-1));

        for(int j=n-layer-2;j>layer;j--)
            a.add(matrix.get(layer).get(j));

        int len=a.size();
        int start=r%len;
        int k=start;

        for(int i=layer;i<m-layer;i++){
            matrix.get(i).set(layer,a.get(k));
            k=(k+1)%len;
        }

        for(int j=layer+1;j<n-layer;j++){
            matrix.get(m-layer-1).set(j,a.get(k));
            k=(k+1)%len;
        }

        for(int i=m-layer-2;i>=layer;i--){
            matrix.get(i).set(n-layer-1,a.get(k));
            k=(k+1)%len;
        }

        for(int j=n-layer-2;j>layer;j--){
            matrix.get(layer).set(j,a.get(k));
            k=(k+1)%len;
        }
    }

    for(List<Integer> row:matrix){
        for(int i=0;i<row.size();i++){
            if(i>0)
                System.out.print(" ");
            System.out.print(row.get(i));
        }
        System.out.println();
    }
}
